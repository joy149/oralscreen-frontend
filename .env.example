# Copy to .env and fill in. Vite inlines every VITE_* variable into the built
# JS, so NEVER put a secret here — everything below is public by design.

# Base URL of the Spring Boot backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Shown in the app footer for clinical credibility.
# Leave blank (or as a [Bracketed] placeholder) and the app falls back to
# "Every screening is reviewed by a licensed dentist" rather than printing
# the placeholder to patients.
VITE_DOCTOR_NAME=
VITE_HOSPITAL_NAME=

# Clinic number for the "Call to book an appointment" button on moderate/high
# risk results. Leave blank to hide the button — the result screen then tells
# the patient to contact their clinic instead of offering a dead control.
VITE_CLINIC_PHONE=

# How long doctor review usually takes, shown in "What happens next".
# Defaults to "24 hours".
VITE_REVIEW_SLA=

# Firebase phone-auth (public client config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
